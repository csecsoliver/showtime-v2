import Widget from require "lapis.html"
locales = require "libs/locales"
class IndexPage extends Widget
    content: =>
        h2 "Információk szülőknek és pedagógusoknak az MFM-Projektről"
        img src: "/static/homepage_image.jpg", alt: "Ciklus-show", style: "float: right; margin-left: 20px; width: 30rem;"
        p "„Csak arra vigyázok, amit értékesnek tartok!”"
        p "Alkalom, hogy a résztvevők megismerjék saját testünk különlegességét és csodás voltát."
        p "A látványos, izgalmas, újszerű bemutatón, a félnapos „Ciklus-show” foglalkozás keretein belül a testi folyamatok, a ciklus-történések bemutatása főként az érzelmeket és az érzékszerveket szólítja meg, de nem hiányzik az ismeret sem! A program olyan információkat nyújt, melyek még (sajnos) nem tartoznak a mindennapi tudáshoz."
        p "Központi gondolat: a serdülő lányok önképét és életérzését nagymértékben meghatározza, milyennek tapasztalják meg és értékelik a testüket, milyen üzeneteket hallanak testükkel - így saját magukkal kapcsolatban."
        p "Nem elméletileg, nem röviden és tömören, s leginkább nem suttogva, a szánk elé tartott kezünk mögül, hanem látványosan, szórakoztatóan és kedvesen adunk teret ennek a témának." 
        p "A lányok érzik, hogy ami a testükben zajlik, mindenképpen szóra érdemes!"
        h3 "Szülői visszajelzések"
        ul ->
            li "„Egészséges derű és humor lengte körül a kislányok számára még szorongató témát. Köszönöm…”"
            li "„Tapasztalatom szerint nagy élmény volt a lányoknak, hogy közösen, játékosan, szégyenérzet nélkül játszották el az élet kezdetét. Köszönjük.”"
            li "„Gyakorló szülőként úgy gondolom, hogy nehéz erről a témáról beszélni. Nekem sokat segített ez a délután. Azt hiszem, hogy az első lépés ahhoz, hogy boldog felnőtt legyen a gyermekem. Köszönöm.”"
            li "„Mindenképpen köszönöm! Bizonyára, aki megismerkedik ezzel a programmal, rengeteg gátlástól, félelemtől szabadulhat meg. Örülök továbbá azért is, mert számomra ez nagyon nem adatott meg serdülőként…”"
            li "„Érdekes, játékos, megható volt. Újra lenne kedvem ezt az élményt átélni.”"
        -- p locales.welcome
        -- h2 locales.readme
        -- a href: "https://github.com/csecsoliver/showtime-v2", "Link"